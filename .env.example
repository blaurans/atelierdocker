# Port d'écoute sur la machine hôte (le portail est toujours sur 8000 en interne).
ARENA_PORT=8000

# Clé d'administration pour /api/stats et /api/admin/*. vide = ouverte.
ARENA_ADMIN_KEY=

# 1 = un flag correct reste en attente de validation par l'enseignant.
ARENA_ATTESTATION=0

# Guidage d'affichage. 0 (défaut) = toutes les missions accessibles d'emblée,
# on valide dans l'ordre qu'on veut. 1 = le plan ne montre que la mission
# suivante comme ouverte. Ce n'est PAS une contrainte serveur : /api/submit
# n'accepte que le flag, dans les deux cas. Pour une vraie contrainte, voyez
# ARENA_ATTESTATION=1.
ARENA_LINEAR=0

# Plafonds de débit par IP et par route (fenêtre d'une minute) :
#   inscription 12 · soumission 40 · lecture programme 120 · flux live 20
# `off` désactive tout plafond — pour des tests automatisés uniquement.
ARENA_RATE_LIMIT=on

# 1 seulement si un reverse proxy se trouve réellement devant le portail :
# le comptage se fait alors sur X-Forwarded-For, forgeable sans proxy.
ARENA_TRUST_PROXY=